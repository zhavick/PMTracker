# ==============================================================================
# WORK TRACKER PRO - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin berkas ini ke `.env` untuk konfigurasi lokal/deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE URLS & INTER-SERVICE CONNECTION (FRONTEND <-> BACKEND)
# ------------------------------------------------------------------------------
# URL Backend API yang digunakan oleh Frontend SPA (Browser/Client)
VITE_API_BASE_URL=http://localhost:5000
BACKEND_BASE_URL=http://localhost:5000

# URL Frontend yang diizinkan mengakses Backend melalui kebijakan CORS
FRONTEND_BASE_URL=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CREDENTIALS (MYSQL 8.4)
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=RootPassword2026!
MYSQL_DATABASE=worktracker_db
MYSQL_USER=tracker_user
MYSQL_PASSWORD=TrackerPassword2026!

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION SETTINGS
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=WorkTrackerPro_SuperSecretKey_Production_2026_Minimum256BitsKey!
JWT_ISSUER=WorkTrackerPro
JWT_AUDIENCE=WorkTrackerProClient
JWT_EXPIRATION_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. EXPOSED PORTS (DOCKER / LOCALHOST)
# ------------------------------------------------------------------------------
MYSQL_PORT=3306
BACKEND_PORT=5000
FRONTEND_PORT=3000
